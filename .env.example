# Copy to .env.local for development. Vercel: set these in Project Settings → Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# "supabase" (default) or "demo" (in-memory anonymized data, no login needed)
VITE_DATA_SOURCE=supabase

# Server-side only (Vercel function /api/assistant). Never prefix with VITE_.
ANTHROPIC_API_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
